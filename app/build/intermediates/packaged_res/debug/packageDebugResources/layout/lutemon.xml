<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/IW_lutemonPic"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/tv_lutemonName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/IW_lutemonPic"
            app:layout_constraintTop_toTopOf="@+id/IW_lutemonPic"
            tools:text="Lutemon Name" />

        <TextView
            android:id="@+id/tv_LutemonColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/IW_lutemonPic"
            app:layout_constraintTop_toBottomOf="@+id/tv_lutemonName"
            tools:text="Color" />

        <TextView
            android:id="@+id/tv_LutemonHealth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:textSize="14sp"
            app:drawableStartCompat="@android:drawable/ic_menu_agenda" android:drawablePadding="4dp" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/IW_lutemonPic"
            app:layout_constraintTop_toBottomOf="@+id/tv_LutemonColor"
            tools:text="HP: 20/20" />


        <TextView
            android:id="@+id/tv_lutemonAttack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:textSize="14sp"
            app:drawableStartCompat="@android:drawable/ic_menu_compass" android:drawablePadding="4dp" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/IW_lutemonPic"
            app:layout_constraintTop_toBottomOf="@+id/tv_LutemonHealth"
            tools:text="Atk: 5" />

        <TextView
            android:id="@+id/tv_lutemonDefense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:textSize="14sp"
            app:drawableStartCompat="@android:drawable/ic_menu_manage" android:drawablePadding="4dp" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/IW_lutemonPic"
            app:layout_constraintTop_toBottomOf="@+id/tv_lutemonAttack"
            tools:text="Def: 4" />

        <TextView
            android:id="@+id/tv_Lutemonexp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:textSize="14sp"
            app:drawableStartCompat="@android:drawable/star_on" android:drawablePadding="4dp" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/IW_lutemonPic"
            app:layout_constraintTop_toBottomOf="@+id/tv_lutemonDefense"
            tools:text="XP: 0" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>